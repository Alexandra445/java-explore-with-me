        {
          "name": "Создать событие",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
                  "const p = (n) => String(n).padStart(2, '0');",
                  "const s = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());",
                  "pm.collectionVariables.set('eventDate', s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ответ должен содержать код статуса 201 и данные в формате json\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.collectionVariables.set('eventId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{authorId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{authorId}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Comments test event\",\n  \"annotation\": \"Annotation of the event used to test comments feature\",\n  \"description\": \"Description of the event used to test the comments feature of the application\",\n  \"category\": {{categoryId}},\n  \"eventDate\": \"{{eventDate}}\",\n  \"location\": {\"lat\": 55.75, \"lon\": 37.62},\n  \"paid\": false,\n  \"participantLimit\": 0,\n  \"requestModeration\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
