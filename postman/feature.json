        {
          "name": "Добавление комментария",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ответ должен содержать код статуса 201 и данные в формате json\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.be.json;",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Данные комментария должны соответствовать запросу\", function () {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.text).to.equal('Отличное событие, обязательно приду!');",
                  "    pm.expect(body.event).to.equal(Number(pm.collectionVariables.get('eventId')));",
                  "    pm.expect(body.author.id).to.equal(Number(pm.collectionVariables.get('authorId')));",
                  "    pm.expect(body.created).to.be.a('string');",
                  "    pm.expect(body.updated).to.be.null;",
                  "});",
                  "pm.collectionVariables.set('commentId', body.id);"
                ]
              }
            }
